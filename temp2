        {/* 3. BOTTOM NAV: TIMELINE */}
        <div className="h-16 bg-background border-t flex items-center px-4 shadow-[0_-5px_15px_rgba(0,0,0,0.02)] z-30 shrink-0">
          <ScrollArea className="w-full whitespace-nowrap">
            <div className="flex items-center gap-3 p-1">
              {days.map((day, idx) => (
                <button
                  key={day.id}
