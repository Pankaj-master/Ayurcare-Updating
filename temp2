/* ---------------------------------------
   4. SUB-COMPONENTS (Internal)
----------------------------------------- */

function MealSection({
  title,
  time,
  icon,
  items,
  mealType,
  isActive,
  onActivate,
  onRemove,
  onUpdateQty,
}) {
  const totalCals = items.reduce(
    (acc, curr) => acc + calculateNutrition(curr.food, curr.quantity).calories,
    0
  );

  return (
    <div
      onClick={onActivate}
      className={`rounded-xl border-2 transition-all duration-200 bg-card ${
        isActive
          ? "border-primary shadow-[0_0_0_4px_rgba(0,0,0,0.05)]"
          : "border-transparent shadow-sm hover:border-border"
      }`}
    >
      <div
        className={`px-6 py-3 border-b flex justify-between items-center ${
          isActive ? "bg-primary/5" : ""
        }`}
      >
        <div className="flex items-center gap-3">
          <div
            className={`p-2 rounded-lg ${
              isActive
                ? "bg-primary/10 text-primary"
                : "bg-muted text-muted-foreground"
            }`}
          >
            {icon}
          </div>
          <div>
            <h4 className="font-bold">{title}</h4>
            <span className="text-xs text-muted-foreground font-medium flex items-center gap-1">
              <Clock className="w-3 h-3" /> {time}
            </span>
          </div>
        </div>
        <div className="text-right">
          <span className="text-sm font-bold text-muted-foreground">
            {totalCals} kcal
          </span>
        </div>
      </div>
      <div className="p-4 space-y-2 min-h-[100px]">
        {items.length === 0 ? (
          <div className="h-full flex flex-col items-center justify-center text-muted-foreground/50 py-6 border-2 border-dashed rounded-lg">
            <span className="text-sm italic">No foods added</span>
          </div>
        ) : (
          items.map((item) => (
            <AddedFoodRow
              key={item.instanceId}
              item={item}
              mealType={mealType}
              onRemove={onRemove}
              onUpdateQty={onUpdateQty}
            />
          ))
        )}
      </div>
    </div>
  );
}

function AddedFoodRow({ item, mealType, onRemove, onUpdateQty }) {
  const nutrition = calculateNutrition(item.food, item.quantity);
  return (
    <div className="flex items-center justify-between p-3 bg-muted/30 rounded-lg border group hover:border-primary/50 transition-colors">
      <div className="flex-1">
        <div className="flex items-center gap-2">
          <span className="font-semibold text-sm">{item.food.name}</span>
          <span
            className={`text-[10px] px-1.5 py-0.5 rounded border ${getDoshaColor(
              item.food.dosha
            )}`}
          >
            {item.food.dosha}
          </span>
        </div>
        <div className="text-xs text-muted-foreground mt-1 flex gap-2">
          <span>{nutrition.calories} kcal</span>
          <span>• P: {nutrition.protein}g</span>
        </div>
      </div>
      <div className="flex items-center gap-4">
        <div className="flex items-center bg-background border rounded-md h-8">
          <input
            type="number"
            className="w-12 text-center text-sm border-none focus:ring-0 p-0 h-full bg-transparent"
            value={item.quantity}
            onChange={(e) =>
              onUpdateQty(mealType, item.instanceId, e.target.value)
            }
          />
          <span className="text-xs text-muted-foreground pr-2">g</span>
        </div>
        <button
          onClick={(e) => {
            e.stopPropagation();
            onRemove(mealType, item.instanceId);
          }}
          className="text-muted-foreground hover:text-destructive transition-colors"
        >
          <Trash2 className="w-4 h-4" />
        </button>
      </div>
    </div>
  );
}

