              </div>

              {/* Filter Chips */}
              <div className="flex gap-2 overflow-x-auto pb-1">
                {["All", "Vata", "Pitta", "Kapha"].map((type) => (
                  <button
                    key={type}
                    onClick={() => setPantryFilter(type)}
