    const newDayNum = days.length + 1;
    setDays([
      ...days,
      {
        id: newDayNum,
        meals: { breakfast: [], lunch: [], snack: [], dinner: [] },
      },
    ]);
    setActiveDayIndex(days.length);
  };

  const handleAddFoodToMeal = (foodItem) => {
    const newDays = [...days];
    const currentDay = newDays[activeDayIndex];
    currentDay.meals[activeMealType].push({
      instanceId: Date.now(),
      food: foodItem,
      quantity: 100, // Default 100g
    });
    setDays(newDays);
  };

  const handleRemoveFood = (mealType, instanceId) => {
    const newDays = [...days];
    const currentDay = newDays[activeDayIndex];
    currentDay.meals[mealType] = currentDay.meals[mealType].filter(
      (item) => item.instanceId !== instanceId
    );
    setDays(newDays);
  };

  const handleUpdateQuantity = (mealType, instanceId, newQty) => {
    const newDays = [...days];
    const currentDay = newDays[activeDayIndex];
    const item = currentDay.meals[mealType].find(
      (i) => i.instanceId === instanceId
    );
    if (item) item.quantity = parseInt(newQty) || 0;
    setDays(newDays);
  };

  const calculateDayTotals = (dayIndex) => {
    const currentDay = days[dayIndex];
    if (!currentDay) return { calories: 0, protein: 0, carbs: 0, fat: 0 };

    let totals = { calories: 0, protein: 0, carbs: 0, fat: 0 };
    Object.keys(currentDay.meals).forEach((mealKey) => {
      currentDay.meals[mealKey].forEach((item) => {
        const stats = calculateNutrition(item.food, item.quantity);
        totals.calories += stats.calories;
        totals.protein += stats.protein;
        totals.carbs += stats.carbs;
        totals.fat += stats.fat;
      });
    });
    return totals;
  };

