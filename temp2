              </div>

              {/* Search */}
              <div className="relative">
                <Search className="absolute left-2 top-2.5 h-4 w-4 text-muted-foreground" />
                <Input
                  placeholder="Search foods..."
                  className="pl-8 bg-white border"
                  value={pantrySearch}
                  onChange={(e) => setPantrySearch(e.target.value)}
