                  F: {currentTotals.fat}g
                </Badge>
              </div>
            </div>

            {/* Scrollable Meals */}
            <ScrollArea className="flex-1 p-6 bg-gradient-to-b from-white to-blue-50/40">
              <div className="space-y-6 pb-24">
                {["breakfast", "lunch", "snack", "dinner"].map((mType) => (
                  <MealSection
