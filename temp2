              </div>

              <div className="flex gap-2">
                <Badge
                  variant="outline"
                  className="bg-blue-100 text-blue-700 border-blue-300"
                >
                  P: {currentTotals.protein}g
                </Badge>
                <Badge
                  variant="outline"
                  className="bg-orange-100 text-orange-700 border-orange-300"
                >
                  C: {currentTotals.carbs}g
