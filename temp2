            </Button>
            <div className="flex flex-col">
              <span className="text-xs font-bold text-primary uppercase tracking-wider">
                New Ayurvedic Plan
              </span>
              <div className="flex items-center gap-2">
                <Input
                  className="h-7 w-48 border-none shadow-none text-lg font-bold p-0 focus-visible:ring-0 placeholder:text-muted-foreground"
                  placeholder="Untitled Plan..."
                  value={newPlanMeta.planName}
                  onChange={(e) =>
                    setNewPlanMeta({ ...newPlanMeta, planName: e.target.value })
                  }
                />
                <span className="text-muted-foreground">|</span>
                <Select
                  value={newPlanMeta.patientId}
                  onValueChange={(v) =>
                    setNewPlanMeta({ ...newPlanMeta, patientId: v })
                  }
                >
                  <SelectTrigger className="h-7 w-40 border-none shadow-none text-sm focus:ring-0">
                    <SelectValue placeholder="Select Patient" />
                  </SelectTrigger>
                  <SelectContent>
                    {patients.map((p) => (
                      <SelectItem key={p.id} value={p.id}>
                        {p.name}
                      </SelectItem>
                    ))}
                  </SelectContent>
                </Select>
              </div>
            </div>
          </div>

          <div className="flex items-center gap-3">
            <div className="hidden md:flex flex-col items-end mr-4">
              <span className="text-[10px] uppercase font-bold text-muted-foreground">
                Daily Target
              </span>
              <span className="font-mono font-bold text-primary">
                {currentTotals.calories} / 1800 kcal
              </span>
            </div>
            <Button
              onClick={handleSavePlan}
              className="bg-primary hover:bg-primary/90"
            >
              <Save className="w-4 h-4 mr-2" /> Publish Plan
