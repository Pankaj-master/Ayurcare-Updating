    setIsCreatePlanOpen(false);
    // Reset form
    setDays([
      { id: 1, meals: { breakfast: [], lunch: [], snack: [], dinner: [] } },
    ]);
    setNewPlanMeta({ patientId: "", planName: "", duration: 1 });
  };

