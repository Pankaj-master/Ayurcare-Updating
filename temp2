      id: "mock-" + Date.now(),
      name: newPlanMeta.planName || "Untitled Plan",
      patientId: newPlanMeta.patientId,
      patient: patients.find((p) => p.id === newPlanMeta.patientId),
      doshaType: "VATA", // Mock default
      duration: days.length,
      isActive: true,
      createdAt: new Date().toISOString(),
      items: days, // Store the whole days structure
    };
