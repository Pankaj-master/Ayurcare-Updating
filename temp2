                        ? "12:30 PM"
                        : mType === "snack"
                        ? "04:30 PM"
                        : "07:30 PM"
                    }
                    mealType={mType}
                    items={days[activeDayIndex].meals[mType]}
                    isActive={activeMealType === mType}
                    onActivate={() => setActiveMealType(mType)}
                    onRemove={handleRemoveFood}
                    onUpdateQty={handleUpdateQuantity}
                  />
                ))}
              </div>
            </ScrollArea>
          </div>

          {/* RIGHT: PANTRY */}
          <div className="w-[35%] lg:w-[30%] bg-white flex flex-col shadow-inner">
            {/* Pantry Header */}
            <div className="p-4 border-b space-y-3 bg-white">
              <div className="flex justify-between items-center">
                <h3 className="font-bold text-sm">Food Pantry</h3>
                <Badge variant="secondary" className="text-[10px]">
                  Adding to: {activeMealType.toUpperCase()}
