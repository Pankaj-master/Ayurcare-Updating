# Environment Variables
NODE_ENV=development
PORT=5000

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/ayurvedic_diet_db?schema=public"

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

#Google Translate
GOOGLE_APPLICATION_CREDENTIALS=your-google-translation-key

# CORS
FRONTEND_URL=http://localhost:3000 //change according to the frontend route

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_PATH=uploads/

# Email (Optional - for future features)
SMTP_HOST=yourhost
SMTP_PORT=port
SMTP_SECURE=
SMTP_USER=youremail
SMTP_PASS=password
